{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match env.production.previews.d1_databases in wrangler.jsonc.
  // D1 migration commands read top-level bindings, not the previews block.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openhouse27-dev",
      "database_id": "439bd7c2-f447-430a-a174-f32b04bcd2e1",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql",
    },
  ],
}
