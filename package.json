{
  "name": "openhouse26",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "staff:seed-admin": "bun scripts/seed-admin.ts",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "bun run build && wrangler dev",
    "prepare": "husky && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.57.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@webgpu/types": "^0.1.74",
    "bits-ui": "^2.18.0",
    "cn": "^0.3.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "formsnap": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "qrcode": "^1.5.4",
    "runed": "^0.35.1",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "sveltekit-superforms": "^3.0.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.151.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#db": "./src/lib/server/db/index.ts",
    "#db/*": "./src/lib/server/db/*"
  },
  "dependencies": {
    "jose": "^6",
    "nanoid": "^6.0.2",
    "neverthrow": "^8.2.0",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
