/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openhouse",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
  },
  "upload_source_maps": true,
  "secrets": {
    "required": [
      "AUTH_JWT_SECRET",
      "CERTIFICATE_PRIVATE_JWK",
      "CERTIFICATE_PUBLIC_KEYS",
    ],
  },
  // Local development binding. Configure the real DB separately in env.production.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openhouse27-local",
      "remote": false,
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql",
    },
  ],
  "browser": { "binding": "CERTIFICATE_BROWSER" },
  "r2_buckets": [
    {
      "binding": "CERTIFICATE_ASSETS",
      "bucket_name": "openhouse-certificates-local",
    },
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "492442244723-srs10ae9048lgbab1qfp0hldiel8lvuv.apps.googleusercontent.com",
    "CERTIFICATE_EVENT_ORIGIN": "https://event.local.preview.invalid",
    "CERTIFICATE_ISSUER": "https://verify.local.preview.invalid",
  },
  "env": {
    "production": {
      "browser": { "binding": "CERTIFICATE_BROWSER" },
      "r2_buckets": [
        {
          "binding": "CERTIFICATE_ASSETS",
          "bucket_name": "openhouse-certificates-production",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "remote": true,
          "database_name": "openhouse27",
          "database_id": "748a9871-c120-460e-a9fe-a436865867e1",
          "migrations_dir": "drizzle",
          "migrations_pattern": "drizzle/*/migration.sql",
        },
      ],
      "secrets": {
        "required": [
          "AUTH_JWT_SECRET",
          "CERTIFICATE_PRIVATE_JWK",
          "CERTIFICATE_PUBLIC_KEYS",
        ],
      },
      "vars": {
        "GOOGLE_CLIENT_ID": "492442244723-srs10ae9048lgbab1qfp0hldiel8lvuv.apps.googleusercontent.com",
        "CERTIFICATE_EVENT_ORIGIN": "https://scichulaopenhouse.com",
        "CERTIFICATE_ISSUER": "https://verify.vidyachula.org",
      },
      // Named previews share the cloud development database.
      "previews": {
        "r2_buckets": [
          {
            "binding": "CERTIFICATE_ASSETS",
            "bucket_name": "openhouse-certificates-preview",
          },
        ],
        "d1_databases": [
          {
            "binding": "DB",
            "database_name": "openhouse27-dev",
            "database_id": "439bd7c2-f447-430a-a174-f32b04bcd2e1",
          },
        ],
        "vars": {
          "CERTIFICATE_EVENT_ORIGIN": "https://dev-scichulaopenhouse.com",
          "CERTIFICATE_ISSUER": "https://verify-preview.vidyachula.org",
          "GOOGLE_CLIENT_ID": "492442244723-srs10ae9048lgbab1qfp0hldiel8lvuv.apps.googleusercontent.com",
        },
      },
      "routes": [
        {
          "custom_domain": true,
          "pattern": "verify.vidyachula.org",
          "enabled": true,
          "previews_enabled": false,
        },
        {
          "custom_domain": true,
          "pattern": "scichulaopenhouse.com",
          "enabled": true,
          "previews_enabled": true,
        },
      ],
    },
  },
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
